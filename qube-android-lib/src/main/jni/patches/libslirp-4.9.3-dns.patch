--- libslirp-v4.9.3/src/slirp.c	2026-07-15 08:16:42.056558268 +0000
+++ libslirp-v4.9.3-work/src/slirp.c	2026-07-15 08:29:43.053709367 +0000
@@ -387,6 +387,20 @@
 
 #if defined(__HAIKU__)
 #define RESOLV_CONF_PATH "/boot/system/settings/network/resolv.conf"
+// QUBE: Android lacks /etc/resolv.conf. Resolve a fixed path under
+// the app's qube base directory and read it with the real
+// fopen/stat, so get_dns_addr() works.
+#elif defined(__ANDROID__)
+#include <stdio.h>
+extern const char *qube_base_dir;
+
+static const char *android_resolv_conf_path(void)
+{
+    static char path[512];
+    snprintf(path, sizeof(path), "%s/etc/resolv.conf", qube_base_dir);
+    return path;
+}
+#define RESOLV_CONF_PATH android_resolv_conf_path()
 #else
 #define RESOLV_CONF_PATH "/etc/resolv.conf"
 #endif
