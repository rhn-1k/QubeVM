--- libslirp-v4.9.3/meson.build
+++ libslirp-v4.9.3-work/meson.build
@@ -80,7 +80,14 @@
 
 # libslirp_deps collects both the libslirp dependenc(y|ies) and the
 # platform dependencies.
-libslirp_deps = [ dependency('glib-2.0', static : glib_static) ]
+# QUBE: if glib is not available via pkg-config (e.g. Android cross-build),
+# fall back to a manual declaration since glib is provided by the parent
+# project via extra-cflags / extra-ldflags.
+_glib_dep = dependency('glib-2.0', static : glib_static, required : false)
+if not _glib_dep.found()
+  _glib_dep = declare_dependency(compile_args : [], link_args : ['-lglib-2.0'])
+endif
+libslirp_deps = [ _glib_dep ]
 
 if host_system == 'windows'
   # Windows: pkg-config fails us here because the static version of glib-2.0
@@ -200,7 +207,8 @@
   configuration : conf
 )
 
-if glib_static or fuzzer_build or fuzz_reproduce
+# QUBE: always build as static library for Android embedding
+if true
   lib = static_library('slirp', sources,
     c_args : cargs,
     link_args : libvflag + vflag,
@@ -264,6 +272,8 @@
   link_with : lib,
   include_directories : [include_directories('src'), include_directories('.')],
 )
+# QUBE: QEMU fallback expects the variable name 'slirp_dep'
+slirp_dep = libslirp_libdep
 meson.override_dependency('slirp', libslirp_libdep)
 
 subdir('fuzzing')
