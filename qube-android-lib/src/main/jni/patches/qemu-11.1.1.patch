     q->cwptr = -1;
 }
 
+// QUBE: overflow limit for the keyboard side overflow queue, far above
+// anything a realistic burst of key events should ever reach
+#define QUBE_PS2_KBD_OVERFLOW_LIMIT 4096
+
+// QUBE: queue one keyboard byte into s->qube_overflow instead of dropping
+// it when PS2Queue is full, mouse path keeps using ps2_queue() untouched
+static void ps2_kbd_queue_byte(PS2KbdState *s, int b)
+{
+    PS2State *ps = PS2_DEVICE(s);
+
+    if (PS2_QUEUE_SIZE - ps->queue.count >= 1) {
+        ps2_queue(ps, b);
+        return;
+    }
+
+    if (!s->qube_overflow) {
+        s->qube_overflow = g_queue_new();
+    }
+
+    if (g_queue_get_length(s->qube_overflow) >= QUBE_PS2_KBD_OVERFLOW_LIMIT) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "ps2_kbd, overflow queue full, dropping key byte 0x%02x\n",
+                      b);
+        s->dropped_events++;
+        trace_ps2_kbd_overflow_drop(s, s->dropped_events);
+        return;
+    }
+
+    g_queue_push_tail(s->qube_overflow, GINT_TO_POINTER(b));
+    s->overflow_events++;
+    trace_ps2_kbd_overflow_queue(s, s->overflow_events);
+}
+
+// QUBE: drain the overflow queue back into PS2Queue, called from
+// ps2_read_data() before the IRQ decision, via ps2_queue_noirq()
+void ps2_kbd_drain_overflow(PS2KbdState *kbd)
+{
+    PS2State *ps = PS2_DEVICE(kbd);
+
+    if (!kbd->qube_overflow) {
+        return;
+    }
+
+    while (PS2_QUEUE_SIZE - ps->queue.count >= 1
+           && !g_queue_is_empty(kbd->qube_overflow)) {
+        int b = GPOINTER_TO_INT(g_queue_pop_head(kbd->qube_overflow));
+        ps2_queue_noirq(ps, b);
+    }
+}
+
 /* keycode is the untranslated scancode in the current scancode set. */
