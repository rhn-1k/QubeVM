+	if ((sym >= 123 && sym <= 126)
+	|| (sym >= 33 && sym <= 38)
+	|| (sym >= 40 && sym < 44)
+	|| (sym >= 62 && sym <= 64)
+	|| (sym >= 94 && sym <= 95)
+	|| sym == 58 || sym == 60) {
+		meta_sym = 65505;
+		meta_keycode = 42;
