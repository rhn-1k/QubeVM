diff -ru --no-dereference pristine/meson.build final/meson.build
--- pristine/meson.build	2026-09-17 03:18:37.005933927 +0000
+++ final/meson.build	2026-09-17 03:18:37.020664719 +0000
@@ -56,6 +56,9 @@
 
 with_host_windows = host_machine.system() == 'windows'
 with_host_darwin = host_machine.system() == 'darwin'
+# QUBE: no libdrm/GBM on Android, but real system EGL/GLES exists,
+# treat it like Windows/Darwin below so EGL doesn't require GBM.
+with_host_android = host_machine.system() == 'android'
 
 warnings = [
    '-Werror=enum-int-mismatch',
@@ -86,7 +89,16 @@
 gbm_dep = not_found
 thread_dep = dependency('threads')
 with_vrend = get_option('vrend')
-epoxy_dep = dependency('epoxy', version: '>= 1.5.4', required: with_vrend)
+if with_host_android
+  # QUBE: pkg-config is unreliable in the NDK sysroot, epoxy is
+  # supplied directly via -I/-L (see Makefile config-virgl target).
+  epoxy_dep = declare_dependency(
+    compile_args: [],
+    link_args: ['-lepoxy'],
+    version: '1.5.10')
+else
+  epoxy_dep = dependency('epoxy', version: '>= 1.5.4', required: with_vrend)
+endif
 m_dep = cc.find_library('m', required : false)
 dl_dep = not_found
 if not with_host_windows and not with_host_darwin
@@ -307,8 +319,10 @@
 have_glx = false
 
 if with_egl
-   if cc.has_header('epoxy/egl.h', dependencies: epoxy_dep) and epoxy_dep.get_variable(pkgconfig: 'epoxy_has_egl') == '1'
-      if with_host_windows or with_host_darwin
+   # QUBE: get_variable(pkgconfig:) needs a pkg-config dep, Android's
+   # epoxy_dep isn't one, but we know it was built with -Degl=yes.
+   if cc.has_header('epoxy/egl.h', dependencies: epoxy_dep) and (with_host_android or epoxy_dep.get_variable(pkgconfig: 'epoxy_has_egl') == '1')
+      if with_host_windows or with_host_darwin or with_host_android
          have_egl = true
       else
          if libdrm_dep.found()
@@ -329,7 +343,9 @@
 endif
 
 if with_glx
-   if cc.has_header('epoxy/glx.h', dependencies: epoxy_dep) and epoxy_dep.get_variable(pkgconfig: 'epoxy_has_glx') == '1'
+   # QUBE: epoxy/glx.h exists regardless of build config, so skip GLX
+   # outright on Android instead of trusting the header check alone.
+   if not with_host_android and cc.has_header('epoxy/glx.h', dependencies: epoxy_dep) and epoxy_dep.get_variable(pkgconfig: 'epoxy_has_glx') == '1'
       glx_dep = dependency('x11', required: require_glx)
       have_glx = glx_dep.found()
       conf_data.set('HAVE_EPOXY_GLX_H', 1)
@@ -489,7 +505,9 @@
 endif
 
 subdir('src')
-if with_vrend and not with_host_windows
+if with_vrend and not with_host_windows and not with_host_android
+   # QUBE: vtest isn't needed for QEMU, and it links against a
+   # legacy GCC toolchain path that doesn't exist in NDK r23+.
    subdir('vtest')
 endif
 
